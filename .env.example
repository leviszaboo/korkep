DATABASE_URL=postgres://korkep:korkep@localhost:5432/korkep
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=sk-or-...
GOOGLE_AI_STUDIO_API_KEY=

# --- Pipeline ---
AUTO_CHAIN=true
TRIGGER_MODE=manual
# NEXT_JOB=process  (set automatically per stage)

# --- Scrape stage ---
SCRAPE_CONCURRENCY=4
SCRAPE_EXTRACT_CONCURRENCY=3

# --- Processor (LLM labeling) ---
LLM_CONCURRENCY=5
LLM_PROVIDER=gemini-fallback
LLM_MODEL=google/gemma-4-26b-a4b-it

# --- Embedder ---
EMBEDDING_CONCURRENCY=15
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024

# --- Inline story assignment ---
CLUSTER_SIMILARITY_THRESHOLD=0.72
CLUSTER_TIME_WINDOW_HOURS=24
CLUSTER_MAX_SIZE=12
CLUSTER_MIN_COHERENCE=0.60
CLUSTER_ENTITY_WEIGHT=0.25
CLUSTER_SEMANTIC_WEIGHT=0.65
CLUSTER_TOKEN_WEIGHT=0.10

# --- Recluster (HDBSCAN batch) ---
RECLUSTER_LLM_CONCURRENCY=1
RECLUSTER_LLM_PROVIDER=gemini-fallback
RECLUSTER_LLM_MODEL=google/gemma-4-31b-it
RECLUSTER_MERGE_THRESHOLD=0.90
RECLUSTER_MERGE_MAX_SIZE=24

# --- Batch clusterer (HDBSCAN) ---
HDBSCAN_MAX_CLUSTER_SIZE=24
HDBSCAN_TIME_WEIGHT=0.55
HDBSCAN_TIME_SCALE_HOURS=12.0
HDBSCAN_UMAP_COMPONENTS=22
HDBSCAN_UMAP_NEIGHBORS=15
HDBSCAN_UMAP_MIN_ARTICLES=43

# --- Repair ---
REPAIR_ANALYSIS_CONCURRENCY=1
REPAIR_GRACE_MINUTES=90
