{
  "name": "@korkep/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/db/index.js",
  "types": "./dist/db/index.d.ts",
  "exports": {
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@korkep/shared": "workspace:*",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.8.0",
    "pg": "^8.20.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0"
  }
}
