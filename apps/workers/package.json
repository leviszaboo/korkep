    "embed-cluster": "tsx src/pipeline/embed-cluster-job.ts"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@korkep/api": "workspace:*",
    "@korkep/shared": "workspace:*",
    "@openrouter/sdk": "^0.12.35",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.10.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0"
  }
