# GCP deployment configuration.
# Copy this file to deploy/env.production and fill in real values.

# Project and region
GCP_PROJECT_ID="YOUR_PROJECT_ID"
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPOSITORY="YOUR_REGISTRY_NAME"

# Secret values stored by deploy/setup.sh in Secret Manager.
DATABASE_URL="postgresql://user:pass@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"
REDIS_URL="rediss://default:password@example.upstash.io:6379"
OPENROUTER_API_KEY="sk-or-..."
GOOGLE_AI_STUDIO_API_KEY=

# Cloud Run API service
API_MEMORY=512Mi
API_CPU=1
API_MIN_INSTANCES=0
API_MAX_INSTANCES=3
API_TIMEOUT_SECONDS=60
API_CORS_ORIGIN=*
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX=120
SEARCH_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Cloud Run batch clusterer service
BATCH_CLUSTERER_MEMORY=1Gi
BATCH_CLUSTERER_CPU=1
BATCH_CLUSTERER_MIN_INSTANCES=0
BATCH_CLUSTERER_MAX_INSTANCES=1
BATCH_CLUSTERER_TIMEOUT_SECONDS=300
HDBSCAN_MAX_CLUSTER_SIZE=25
HDBSCAN_TIME_WEIGHT=0.20
HDBSCAN_TIME_SCALE_HOURS=26.0
HDBSCAN_MIN_SAMPLES=1
HDBSCAN_CLUSTER_SELECTION_EPSILON=0.0
HDBSCAN_UMAP_COMPONENTS=22
HDBSCAN_UMAP_NEIGHBORS=15
HDBSCAN_UMAP_MIN_ARTICLES=9999

# Job sizing
MIGRATE_MEMORY=512Mi
MIGRATE_CPU=1
SCRAPE_MEMORY=1Gi
SCRAPE_CPU=1
PROCESS_MEMORY=1Gi
PROCESS_CPU=1
EMBED_CLUSTER_MEMORY=1Gi
EMBED_CLUSTER_CPU=1
RECLUSTER_MEMORY=1Gi
RECLUSTER_CPU=1
REEMBED_MEMORY=1Gi
REEMBED_CPU=1
RESUMMARIZE_MEMORY=1Gi
RESUMMARIZE_CPU=1
REPAIR_MEMORY=1Gi
REPAIR_CPU=1

# Pipeline and LLM tuning
LLM_CONCURRENCY=15
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it
EMBEDDING_CONCURRENCY=20
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
RECLUSTER_LLM_CONCURRENCY=15
RECLUSTER_LLM_PROVIDER=openrouter
RECLUSTER_NO_CACHE=0
RECLUSTER_MERGE_THRESHOLD=0.85
RECLUSTER_MERGE_MAX_SIZE=24
REPAIR_LOOKBACK_HOURS=24
REPAIR_MAX_ARTICLES=100
REPAIR_MAX_STORIES=50
REPAIR_ANALYSIS_CONCURRENCY=1
REPAIR_EMBEDDING_BATCH_SIZE=50
REPAIR_GRACE_MINUTES=90
SCRAPE_CONCURRENCY=4
SCRAPE_EXTRACT_CONCURRENCY=3
CLUSTER_SIMILARITY_THRESHOLD=0.72
CLUSTER_TIME_WINDOW_HOURS=24
CLUSTER_MAX_SIZE=12
CLUSTER_MIN_COHERENCE=0.60
CLUSTER_ENTITY_WEIGHT=0.25
CLUSTER_SEMANTIC_WEIGHT=0.65
CLUSTER_TOKEN_WEIGHT=0.10

# Scheduler
SCHEDULER_TIME_ZONE=Europe/Budapest
SCRAPE_DAY_SCHEDULE="*/15 6-23 * * *"
SCRAPE_NIGHT_SCHEDULE="0 0-5 * * *"
RECLUSTER_SCHEDULE="*/30 6-23 * * *"

# Diagnostics
LOOKBACK_DAYS=7
LOG_LIMIT=20000
CLOUD_RUN_FREE_REQUESTS=2000000
CLOUD_RUN_FREE_VCPU_SECONDS=180000
CLOUD_RUN_FREE_GIB_SECONDS=360000
NEON_FREE_STORAGE_BYTES=536870912
